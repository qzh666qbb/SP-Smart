# ==============================================
# 生产环境变量 — 复制为 .env 后填入真实值
# ==============================================

# ---- 域名 ----
# 管理端 Web 域名（管理员访问）
ADMIN_DOMAIN=admin.yourdomain.com
# 家长端 H5 域名（手机浏览器访问，可选，小程序可不用）
PARENT_H5_DOMAIN=m.yourdomain.com
# 后端 API 域名（小程序和前端共同访问）
API_DOMAIN=api.yourdomain.com

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=training_db
DB_USER=training
DB_PASSWORD=CHANGE_ME_STRONG_DB_PWD

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
# 建议 32+ 位随机字符串，可用命令：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32plus_RANDOM_STRING

# ---- 微信小程序（正式 AppID/Secret）----
# 去 https://mp.weixin.qq.com 申请小程序后获取
WECHAT_APPID=
WECHAT_SECRET=

# ---- SSH ----
# 一键部署脚本使用：目标服务器 SSH 信息
DEPLOY_HOST=root@your-server-ip
DEPLOY_PATH=/opt/training
